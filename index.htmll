<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Ultimate Queen's Quest 👑</title>
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #fef08a, #fbcfe8, #e0f2fe);
            --text-main: #1e3a8a;
            --accent-pink: #ec4899;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: var(--bg-gradient);
            background-size: 300% 300%;
            animation: moveBG 20s ease infinite;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        @keyframes moveBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .quest-container {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 35px;
            max-width: 550px;
            width: 100%;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            border: 3px solid white;
            text-align: center;
        }

        h1 {
            color: var(--text-main);
            font-size: 26px;
            margin-bottom: 10px;
        }

        .progress-bar {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
            background: #e2e8f0;
            border-radius: 10px;
            padding: 4px;
            position: relative;
        }

        .progress-step {
            width: 30px;
            height: 30px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
            color: #64748b;
            transition: all 0.4s ease;
            z-index: 2;
        }

        .progress-step.active {
            background: var(--accent-pink);
            color: white;
            box-shadow: 0 0 10px rgba(236, 72, 153, 0.5);
        }

        .progress-step.completed {
            background: #10b981;
            color: white;
        }

        .riddle-card {
            margin-top: 20px;
            min-height: 200px;
        }

        .riddle-text {
            font-size: 18px;
            color: #334155;
            line-height: 1.6;
            font-style: italic;
            margin-bottom: 25px;
            font-weight: 600;
        }

        .input-group {
            margin-bottom: 20px;
        }

        input[type="text"] {
            width: 80%;
            padding: 12px 20px;
            border: 2px solid #cbd5e1;
            border-radius: 50px;
            font-size: 16px;
            text-align: center;
            outline: none;
            transition: border-color 0.3s;
            text-transform: uppercase;
        }

        input[type="text"]:focus {
            border-color: var(--accent-pink);
        }

        .btn-submit {
            background: linear-gradient(135deg, #ec4899, #f43f5e);
            color: white;
            border: none;
            padding: 12px 35px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(236, 72, 153, 0.3);
            transition: transform 0.2s;
        }

        .btn-submit:active {
            transform: scale(0.95);
        }

        .error-msg {
            color: #ef4444;
            font-size: 14px;
            margin-top: 10px;
            display: none;
            font-weight: 600;
        }

        .success-screen {
            display: none;
        }

        .hint-btn {
            background: none;
            border: none;
            color: #0284c7;
            cursor: pointer;
            text-decoration: underline;
            font-size: 13px;
            margin-top: 10px;
            display: inline-block;
        }
    </style>
</head>
<body>

    <div class="quest-container">
        <div id="game-view">
            <h1>The Ultimate Love Riddle Quest 👑</h1>
            <p style="color: #64748b; font-size: 14px;">Ek ghante ka challenge! Har paheli ka sahi jawab hi agla rasta kholega...</p>

            <div class="progress-bar">
                <div class="progress-step active" id="step-0">1</div>
                <div class="progress-step" id="step-1">2</div>
                <div class="progress-step" id="step-2">3</div>
                <div class="progress-step" id="step-3">4</div>
                <div class="progress-step" id="step-4">5</div>
            </div>

            <div class="riddle-card">
                <p class="riddle-text" id="riddle-display">Loading riddle...</p>
                
                <div class="input-group">
                    <input type="text" id="answer-input" placeholder="Type your answer here..." autocomplete="off">
                </div>
                
                <button class="btn-submit" onclick="checkAnswer()">Unlock Next Stage 🔓</button>
                <br>
                <button class="hint-btn" onclick="showHint()">Need a hint?</button>
                <p class="error-msg" id="error-display">Galat jawab! Dimaag lagayein Begum Sahiba... 🍳</p>
            </div>
        </div>

        <div id="success-view" class="success-screen">
            <h2 style="color: #10b981; font-size: 28px; margin-bottom: 15px;">🎉 Quest Completed! 🎉</h2>
            <div style="font-size: 60px; margin-bottom: 20px;">🏆👑❤️</div>
            <p style="font-size: 20px; color: #1e3a8a; line-height: 1.6; font-weight: 600; margin-bottom: 25px;">
                Wah Meri Jaan! Aapne Extreme Hard Level ko poora crack kar liya! You truly know everything. Mere dil ki asli malika aap hi ho! Love You Forever Always! 💋
            </p>
            <div style="color: #ec4899; font-size: 18px; font-weight: bold;">Umaaah! 🤗❤️</div>
        </div>
    </div>

    <script>
        const questData = [
            {
                riddle: "Main aapka sacha rishta huun, aapki izzat huun, aur aapke dil par raj karne wali aapki sabse badi upadhi huun. Batao main kaun huun?",
                answer: "BEGUM",
                hint: "Suniye... Aap meri kya lagti hain? (5 Letters)"
            },
            {
                riddle: "Jab gussa aati hai toh aap mujhe yeh bolti hain, kitchen ka ek tool bhi huun, lekin phir bhi aap mujhse pyaar karti hain. Batao main kaun huun?",
                answer: "DHAKAN",
                hint: "Aap mujhe pyaar se kya bulati hain jab main ajeeb baatein karta huun? (6 Letters)"
            },
            {
                riddle: "Bina bolay pyaar jatane ka tareeqa huun, honton se honton ka ek chota sa tohfa huun. Batao main kaun huun?",
                answer: "KISS",
                hint: "Jo aapko mujhse chahiye hota hai! (4 Letters)"
            },
            {
                riddle: "Gale se laga kar sukoon dene wali jhappi huun, gusse ko thanda karne wali ek jadoo ki jhappi huun. Batao main kaun huun?",
                answer: "HUG",
                hint: "Pyaar se gale lagana! (3 Letters)"
            },
            {
                riddle: "Main aapka sabse pehla aur sabse pyaari nishaani wala naam huun, aapke aane se meri poori dunya badal gayi. Mera poora naam kya hai?",
                answer: "ANNA",
                hint: "Aapka short name nahi, aapka cute nickname click karein! (4 Letters)"
            }
        ];

        let currentStage = 0;

        function loadStage() {
            if (currentStage >= questData.length) {
                document.getElementById('game-view').style.display = 'none';
                document.getElementById('success-view').style.display = 'block';
                return;
            }

            document.getElementById('riddle-display').innerText = questData[currentStage].riddle;
            document.getElementById('answer-input').value = "";
            document.getElementById('error-display').style.display = 'none';

            // Update Progress Bar
            for (let i = 0; i < questData.length; i++) {
                const step = document.getElementById(`step-${i}`);
                if (i < currentStage) {
                    step.className = "progress-step completed";
                    step.innerText = "✓";
                } else if (i === currentStage) {
                    step.className = "progress-step active";
                    step.innerText = i + 1;
                } else {
                    step.className = "progress-step";
                    step.innerText = i + 1;
                }
            }
        }

        function checkAnswer() {
            const inputVal = document.getElementById('answer-input').value.trim().toUpperCase();
            const correctAns = questData[currentStage].answer;

            if (inputVal === correctAns) {
                currentStage++;
                loadStage();
            } else {
                const errorDisplay = document.getElementById('error-display');
                errorDisplay.style.display = 'block';
                errorDisplay.innerText = "Galat jawab! Thoda aur sochiye Begum Sahiba... 🍳";
            }
        }

        function showHint() {
            const errorDisplay = document.getElementById('error-display');
            errorDisplay.style.display = 'block';
            errorDisplay.style.color = '#0284c7';
            errorDisplay.innerText = "Hint: " + questData[currentStage].hint;
        }

        // Start game
        loadStage();
    </script>
</body>
</html>
